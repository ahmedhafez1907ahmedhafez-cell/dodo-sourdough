# ============================================================
# انسخ الملف ده وسميه .env.local للتجربة على جهازك
# وعلى Vercel: Settings > Environment Variables حط نفس الأسماء دي
# ============================================================

# ---- Firebase (Client) — من Firebase Console > Project Settings > General > Your apps ----
# دول آمنين تماماً إنهم يبانوا في كود المتصفح (مش سرّيين)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase (Admin SDK — سيرفر فقط) ----
# من Firebase Console > Project Settings > Service Accounts > Generate new private key
# هينزلك ملف JSON — انسخ منه الـ 3 قيم دول بالظبط
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# مهم: خلي الـ \n زي ما هي متسابة في القيمة (متمسحهاش)
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- Resend (بريد إلكتروني عند وصول أوردر جديد) — https://resend.com (مجاني حتى 3000 إيميل/شهر) ----
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=your-email@example.com
ORDER_FROM_EMAIL=orders@yourdomain.com

# ---- بوسطة Bosta (سيرفر فقط — متتفتحش للعميل أبداً) ----
# المفتاح بيتولّد من: business.bosta.co ← الإعدادات ← ربط التطبيقات
# للتجربة استخدم BOSTA_API_BASE_URL=https://stg-app.bosta.co
BOSTA_API_KEY=
BOSTA_API_BASE_URL=https://app.bosta.co

# أوردرات بنها بتتوصل بنفسنا — متتبعتش لبوسطة، والعميل بيتحول على واتساب
BOSTA_SKIP_BANHA=true

# توثيق الـ webhook — نفس الاسم والقيمة اللي هتحطهم في بوسطة
# (الإعدادات ← ربط التطبيقات ← إضافة رابط الـ Webhook)
BOSTA_WEBHOOK_HEADER=x-webhook-secret
BOSTA_WEBHOOK_SECRET=
